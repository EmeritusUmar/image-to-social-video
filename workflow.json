    {
      "parameters": {
        "jsCode": "const idea = $('Split').first().json.captionIdea || '';\nconst videoUrl = $input.first().json.movie?.url || '';\n\nreturn [{\n  json: {\n    caption: idea.trim() || 'Watch the transformation unfold. What do you think?',\n    videoUrl\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        432
      ],
      "name": "Create Caption"
    },
    {
      "parameters": {
        "jsCode": "const idea = String($('Split').first().json.captionIdea ?? '').trim();\nif (!idea) throw new Error('Split has no captionIdea');\n\nconst words = idea.split(/\\s+/);\nconst middle = Math.ceil(words.length / 2);\nconst text1 = words.slice(0, middle).join(' ');\nconst text2 = words.slice(middle).join(' ');\n\nreturn [{\n  json: {\n    content: {\n      parts: [{ text: `text1: ${text1}\\ntext2: ${text2}` }]\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        208
      ],
      "name": "Code in JavaScript"
    }
