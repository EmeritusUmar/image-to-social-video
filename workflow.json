    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.content.parts[0].text;\n\nconst lines = aiOutput.replace(/\\\\n/g, '\\n').split('\\n').map(l => l.trim());\nlet text1 = \"\";\nlet text2 = \"\";\n\nfor (const line of lines) {\n  if (line.toLowerCase().startsWith(\"text1:\")) {\n    text1 = line.replace(/^text1:\\s*/i, '').trim();\n  } else if (line.toLowerCase().startsWith(\"text2:\")) {\n    text2 = line.replace(/^text2:\\s*/i, '').trim();\n  }\n}\n\nreturn [{ json: { text1, text2 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        208
      ],
      "name": "Split Text"
