        "bodyParametersJson": "={\n  \"model\": \"Qubico/diffrhythm\",\n  \"task_type\": \"txt2audio-base\",\n  \"input\": {\n    \"style_prompt\": \"{{ $('Split').item.json.musicStyle }}\"\n  },\n  \"config\": {}\n}"
